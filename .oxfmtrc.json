{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".github",
    ".windsurf",
    ".claude",
    "dist",
    "server",
    "tmp",
    "public",
    "src/styles",
    "**/*.md",
    "**/*.mdx",
    "**/*.scss",
    "**/*.css"
  ]
}
