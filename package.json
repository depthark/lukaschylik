{
  "name": "lukas-chylik-portfolio-website",
  "version": "2.0.0",
  "private": true,
  "description": "Modern personal portfolio website built with Qwik featuring SSR, dynamic blog posts, and optimized performance. Showcases skills, services, references, and includes a fully functional blog with markdown support.",
  "keywords": [
    "blog",
    "frontend-developer",
    "personal-website",
    "portfolio",
    "qwik",
    "ssr",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://lukaschylik.dev",
  "license": "MIT",
  "author": {
    "name": "Lukas Chylik",
    "url": "https://lukaschylik.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Luko248/lukaschylik/"
  },
  "type": "module",
  "scripts": {
    "build": "bun run posts:manifest && bun run tailwind:optimize && qwik build && bun run scripts/generate-sitemap.ts && bun run scripts/generate-llms-txt.ts && bun run easter-egg:build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "build:css": "sass src/styles/scss/index.scss src/styles/css/index.css",
    "deploy": "echo 'Run \"bun run qwik add\" to install a server adapter'",
    "dev": "bun run posts:manifest && vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint && knip",
    "lint:fix": "oxlint --fix",
    "lint:ci": "oxlint --deny-warnings && oxfmt --check && knip",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "easter-egg:build": "bun build src/components/bug-squasher/game.ts --outfile dist/easter-egg/bug-squasher.js --minify --target browser --format esm",
    "posts:manifest": "bun run scripts/generate-posts-manifest.ts",
    "preview": "bun run posts:manifest && vite build --ssr src/entry.preview.tsx && vite preview --open",
    "start": "bun run fix && bun run posts:manifest && concurrently \"vite --open --mode ssr\" \"bun run watch:css\"",
    "watch:css": "nodemon",
    "fix": "bun run stylelint:fix && bun run format",
    "tailwind:optimize": "tailwindcss --input ./src/styles/css/tailwind.css --output ./src/styles/css/tailwind.optimized.css --minify",
    "qwik": "qwik"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@toolwind/anchors": "^1.0.10",
    "caniuse-lite": "^1.0.30001806",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.38",
    "@qwik.dev/router": "^2.0.0-beta.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "knip": "^6.31.0",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "postcss-preset-env": "^11.3.2",
    "postcss-scss": "^4.0.9",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not op_mini all",
    "not android < 5",
    "not ios < 12"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "trustedDependencies": [
    "@parcel/watcher",
    "@toolwind/anchors",
    "esbuild",
    "sharp"
  ],
  "trustedDependencies-annotation": "Needed for bun to allow running install scripts"
}
